apiVersion: apps/v1
kind: Deployment
metadata:
  name: pd-pfirst-prefill-${SLICE}
  labels:
    llm-d.ai/inference-serving: "true"
    llm-d.ai/guide: topology-aware-prefill-first
    llm-d.ai/model: gpt-oss-120b
    llm-d.ai/role: prefill
    llm-d.ai/topology-slice: "${SLICE}"
spec:
  replicas: 4
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: pd-pfirst-prefill-${SLICE}
  template:
    metadata:
      labels:
        app: pd-pfirst-prefill-${SLICE}
        llm-d.ai/inference-serving: "true"
        llm-d.ai/guide: topology-aware-prefill-first
        llm-d.ai/model: gpt-oss-120b
        llm-d.ai/role: prefill
        llm-d.ai/topology-slice: "${SLICE}"
    spec:
      nodeSelector:
        kubernetes.io/hostname: ${NODE}
      tolerations:
        - key: is_gpu
          operator: Exists
          effect: PreferNoSchedule
      containers:
        - name: modelserver
          image: vllm/vllm-openai:v0.23.0
          imagePullPolicy: IfNotPresent
          command: ["vllm", "serve"]
          args:
            - openai/gpt-oss-120b
            - --disable-access-log-for-endpoints=/health,/metrics,/v1/models
            - --tensor-parallel-size=1
            - --block-size=128
            - --kv-transfer-config
            - '{"kv_connector":"NixlConnector","kv_role":"kv_both","kv_buffer_device":"cuda","kv_connector_extra_config":{"backends":["UCX"]}}'
            - --no-disable-hybrid-kv-cache-manager
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              add:
                - IPC_LOCK
          env:
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef:
                  name: llm-d-hf-token
                  key: HF_TOKEN
            - name: HF_HOME
              value: /models
            - name: VLLM_CACHE_ROOT
              value: /models/vllm-cache/prefill-tp1
            - name: USER
              value: llm-d
            - name: VLLM_NIXL_SIDE_CHANNEL_HOST
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            - name: VLLM_HTTP_TIMEOUT_KEEP_ALIVE
              value: "120"
            - name: NIXL_LOG_LEVEL
              value: INFO
            - name: UCX_LOG_LEVEL
              value: info
            - name: UCX_PROTO_INFO
              value: "y"
            - name: UCX_PROTO_ENABLE
              value: "y"
            - name: UCX_TLS
              value: rc,sm,cuda_ipc,cuda_copy,tcp
            - name: UCX_NET_DEVICES
              value: all
            - name: UCX_SOCKADDR_TLS_PRIORITY
              value: tcp
          ports:
            - name: modelserver
              containerPort: 8000
            - name: nixl
              containerPort: 5600
          resources:
            requests:
              cpu: "8"
              memory: 16Gi
              nvidia.com/gpu: "1"
              rdma/ib: "1"
            limits:
              memory: 16Gi
              nvidia.com/gpu: "1"
              rdma/ib: "1"
          startupProbe:
            httpGet:
              path: /v1/models
              port: modelserver
            initialDelaySeconds: 15
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 120
          livenessProbe:
            httpGet:
              path: /health
              port: modelserver
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /v1/models
              port: modelserver
            periodSeconds: 5
            timeoutSeconds: 2
            failureThreshold: 3
          volumeMounts:
            - name: shm
              mountPath: /dev/shm
            - name: model-cache
              mountPath: /models
            - name: torch-compile-cache
              mountPath: /.cache
            - name: vllm-config
              mountPath: /.config
            - name: triton-cache
              mountPath: /.triton
      volumes:
        - name: shm
          emptyDir:
            medium: Memory
            sizeLimit: 20Gi
        - name: model-cache
          persistentVolumeClaim:
            claimName: topology-prefill-first-model-cache
        - name: torch-compile-cache
          emptyDir: {}
        - name: vllm-config
          emptyDir: {}
        - name: triton-cache
          emptyDir: {}
